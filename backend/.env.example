PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/storybridge
# Use a long random string in production (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=7
CLIENT_ORIGIN=http://localhost:3000

# Used by `npm run seed`
SEED_ADMIN_EMAIL=admin@storybridge.test
SEED_ADMIN_PASSWORD=Admin12345
